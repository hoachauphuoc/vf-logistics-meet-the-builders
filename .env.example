# VF Logistics Fraud Detection — Google Cloud

# Your GCP project ID
PROJECT_ID=your-project-id

# Vertex AI location. Must be `global` — Gemini 3.5 Flash is not served
# from regional endpoints (us-central1 / asia-southeast1 return 404).
LOCATION=global

# Port gunicorn binds to. Cloud Run sets this automatically.
PORT=8080

# How cases advance. `ondemand` runs them inside request handlers, which is what
# the deployed service uses and costs nothing while idle. `poll` starts an
# always-on background loop and needs --no-cpu-throttling --min-instances=1.
WORKER_MODE=ondemand

# `firestore` (default) or `memory` for a run with no database at all.
STORE_BACKEND=firestore

# Cloud Storage bucket where uploaded documents are archived. Set this: without
# it no case keeps a document for the reviewer to read.
DOCUMENT_BUCKET=your-document-bucket

# Pub/Sub topic that receives each terminal decision.
DECISIONS_TOPIC=case-decisions

# Model Armor template that screens uploaded documents for prompt injection.
# It must exist in MODEL_ARMOR_LOCATION; see infra/model_armor_template.json.
# An empty value disables the gate.
MODEL_ARMOR_TEMPLATE=vf-document-intake
MODEL_ARMOR_LOCATION=asia-southeast1

# --- Roadmap only: not read by the current code path ---
# FIRESTORE_DATABASE=(default)
# BQ_DATASET=fraud_detection
# PUBSUB_TOPIC=shipment-events   # unrelated to DECISIONS_TOPIC above
